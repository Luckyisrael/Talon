FROM redroid/redroid:14.0.0_64only-latest

LABEL description="SeekerStudio Redroid — pre-baked with mock wallet + dev-client"

# Copy APKs into the image (installed at first boot, not build time)
COPY backend/template/mock-wallet/v1.0.0/fakewallet-debug.apk /opt/seeker/fakewallet.apk
COPY backend/template/mock-wallet/v1.0.0/fakedapp-debug.apk /opt/seeker/fakedapp.apk
COPY backend/template/dev-client/v1.0.0/app-debug.apk /opt/seeker/devclient.apk

# Copy the boot-time install script (chmod done on host before COPY)
COPY infra/redroid/install-seeker-apps.sh /opt/seeker/install-apps.sh

# The install script runs at container start (not build time)
# because ADB needs the device to be booted first
ENTRYPOINT ["/opt/seeker/install-apps.sh"]
