# Dependencies
node_modules/
vendor/
backend/template/node_modules/

# Build outputs
backend/bin/
*.exe
*.test
*.out

# Next.js
frontend/.next/
frontend/out/
frontend/build/
# Stray Next.js trace artifacts (wrong-cwd build runs)
**/.next/

# Environment & secrets — never commit a real .env. dev.sh reads it at
# runtime; .env.example shows the shape.
.env
.env.*
!.env.example

# Dev launcher's runtime artifacts (pids, logs)
.dev-logs/

# Android
android/
local.properties
*.keystore
*.jks
# Release signing keystores (per-project, generated at first export)
keystores/
backend/keystores/
# Release export artifacts (signed APKs, scratch dirs, store assets)
backend/exports/

# Backend template build artifacts
backend/template/android/
backend/template/.expo/
backend/template/dev-client/**/*.apk
backend/template/mock-wallet/**/*.apk

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Workspaces (runtime)
workspaces/
# Breaktest scratch workspace (e2e/run-breaktest.sh wipes it per run)
workspaces-breaktest/

# Staging
.staging/

# Expo
.expo/
dist/

# Go
*.exe~

# Misc
server.exe~

# Docker
.docker/

# Coverage
coverage/
*.cover

# Debug
*.pid

# Yarn
frontend/yarn.lock

# Template lockfile is tracked: reproducible installs via `npm ci` in
# build-template.sh (P5). The old ignore predates that decision.
backups/
.tools/
backend/server

# E2E scratch artifacts
backend/e2e
backend/workspaces-e2e/
backend/scrcpy-server.jar
e2e/live-run*.log
e2e/artifacts/
# W13.5: nightly scorecard publications (local artifacts, not sources) —
# but the behavioral run reports are the evidence Appendix A/B cite, so the
# behavior-* tables stay trackable.
e2e/reports/*
!e2e/reports/behavior-*.md

# stale committed build artifacts

# tool caches (session-local)
.gocache/
.gopath/
.gradle-tmp/
vendored-skills-reference/

# Local agent skill mirrors and assistant settings (machine-local, rebuildable)
agent/
.agents/
.claude/
