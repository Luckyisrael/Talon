# Copy to .env and point at your backend. LAN IP, never localhost:
# localhost on-device is the phone itself. Use the "API at ..." line
# dev.sh prints (backend PUBLIC_HOST:PORT).
EXPO_PUBLIC_API_URL=http://192.168.1.6:8080

# Web app origin for out-links (docs). Same host as the API on port 3000.
# EXPO_PUBLIC_WEB_URL=http://192.168.1.6:3000
