# Talon — environment
#
# Copy to .env and fill in the values. Everything marked REQUIRED must be set or
# the server exits at startup with a message naming what is missing.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./talon.db
WORKSPACE_DIR=./workspaces
TEMPLATE_DIR=./backend/template

# production | staging | development. Anything other than development makes a
# weak or missing JWT_SECRET fatal instead of a warning.
ENV=development

# ── Auth — REQUIRED ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# At least 32 characters. Leaving this empty in development signs everyone out on
# every restart; leaving it empty in production stops the server.
JWT_SECRET=

# ── AI provider — REQUIRED ────────────────────────────────────────────────────
# One transport, four variables. AI_PROTOCOL selects the wire format:
#   anthropic → POST {AI_BASE_URL}/v1/messages
#   openai    → POST {AI_BASE_URL}/chat/completions  (OpenRouter, Together, vLLM…)
#
# Anthropic direct:
#   AI_PROTOCOL=anthropic
#   AI_BASE_URL=https://api.anthropic.com
#   AI_MODEL=claude-opus-5
#
# OpenRouter:
#   AI_PROTOCOL=openai
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat
AI_PROTOCOL=anthropic
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-opus-5
# Optional cheap tier: short follow-up edits and the plan-mode survey (W3.5)
# run on it when set; unset falls back to AI_MODEL. Same value is reachable as
# the medium/weak tiers of ROUTING_POLICY_JSON.
AI_MODEL_CHEAP=

# ── CORS ──────────────────────────────────────────────────────────────────────
# localhost:3000/3001 are always allowed. Add production origins here as a
# comma-separated list of full origins, scheme included. This list also gates
# WebSocket handshakes, so a browser origin missing from it cannot open the
# device stream or terminal.
CORS_ALLOWED_ORIGINS=

# ── Behind a proxy ────────────────────────────────────────────────────────────
# Set to true ONLY when a load balancer or ingress you control overwrites
# X-Forwarded-For. While it is false the header is ignored, because otherwise any
# client can rotate it to get a fresh rate-limit bucket per request.
TRUST_PROXY=false

# ── Devices ───────────────────────────────────────────────────────────────────
# Concurrent Redroid containers. Each one is roughly 2 GB of RAM.
MAX_CONTAINERS=5

# Needed for native builds and the dev client. Usually already set by the SDK
# install; listed here so a container image can be checked against it.
# ANDROID_HOME=/opt/android-sdk
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# ── Optional ──────────────────────────────────────────────────────────────────
# Raises the GitHub API rate limit for the agent's research tool.
GITHUB_TOKEN=

# ── Harness flags — all ship dark (unset = off); set to 1/true/on/v1 ──────────
# Shadow-based retention (W1.1): TrimConversation writes a shadow marker into
# the session log so old turns drop out of what the model sees instead of
# being deleted from storage — the destructive delete is gone either way.
# Unset = trim is a no-op and the full transcript stays visible to the model.
TALONSTUDIO_TRIM_SHADOW=

# Delegation (H9/W1.5): registers delegate, delegate_fork, list_children —
# scoped child loops on the same model (a fork child starts from this
# conversation's history and forks its session log). One opt-in gates all of
# them. Unset = no delegation tools at all.
TALONSTUDIO_SUBAGENTS=

# Session-log read path (H1/W2): dual-write is always on; TALONSTUDIO_SESSIONLOG=derive
# reads the model's history from the append-only session log's projection instead of
# conversation_messages — proven message-for-message equivalent by the parity harness
# (api/TestPhaseW2ReadParity). Unset/legacy = today's table reads; the default flips
# only after two green CI weeks (PLAN_WORLDCLASS W2.2), with this value as rollback.
TALONSTUDIO_SESSIONLOG=

# Plan with eyes (W3.1/W3.3): plan turns get the read-only tool subset (list_files,
# read_file, grep_codebase, find_files, project_map, explore) in a bounded loop
# (maxPlanRounds=8) so the planner surveys the real workspace before drafting.
# Mutation stays impossible by tool absence; any failure falls back to today's
# tool-less single-shot plan call. Unset = today's tool-less plan path, byte for byte.
TALONSTUDIO_PLAN_TOOLS=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
