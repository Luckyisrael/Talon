# SeekerStudio — Environment Variables
# Copy this file to .env and fill in the values.

# Server
PORT=8080
DB_PATH=./seekersstudio.db
WORKSPACE_DIR=./workspaces
TEMPLATE_DIR=./backend/template

# JWT — REQUIRED (server will not start without it in production)
JWT_SECRET=

# AI Provider (agentrouter or openrouter)
AI_PROVIDER=agentrouter

# Anthropic / AgentRouter
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-5

# OpenRouter (fallback)
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
AI_MODEL=

# CORS (production origin)
CORS_ALLOWED_ORIGIN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
