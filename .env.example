# Talon — environment
#
# Copy to .env and fill in the values. Everything marked REQUIRED must be set or
# the server exits at startup with a message naming what is missing.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./talon.db
WORKSPACE_DIR=./workspaces
TEMPLATE_DIR=./backend/template

# production | staging | development. Anything other than development makes a
# weak or missing JWT_SECRET fatal instead of a warning.
ENV=development

# ── Auth — REQUIRED ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# At least 32 characters. Leaving this empty in development signs everyone out on
# every restart; leaving it empty in production stops the server.
JWT_SECRET=

# ── AI provider — REQUIRED ────────────────────────────────────────────────────
# One transport, four variables. AI_PROTOCOL selects the wire format:
#   anthropic → POST {AI_BASE_URL}/v1/messages
#   openai    → POST {AI_BASE_URL}/chat/completions  (OpenRouter, Together, vLLM…)
#
# Anthropic direct:
#   AI_PROTOCOL=anthropic
#   AI_BASE_URL=https://api.anthropic.com
#   AI_MODEL=claude-opus-5
#
# OpenRouter:
#   AI_PROTOCOL=openai
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat
AI_PROTOCOL=anthropic
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-opus-5
# Optional cheap tier: short follow-up edits and the plan-mode survey (W3.5)
# run on it when set; unset falls back to AI_MODEL. Same value is reachable as
# the medium/weak tiers of ROUTING_POLICY_JSON.
AI_MODEL_CHEAP=

# ── CORS ──────────────────────────────────────────────────────────────────────
# localhost:3000/3001 are always allowed. Add production origins here as a
# comma-separated list of full origins, scheme included. This list also gates
# WebSocket handshakes, so a browser origin missing from it cannot open the
# device stream or terminal.
CORS_ALLOWED_ORIGINS=

# ── Behind a proxy ────────────────────────────────────────────────────────────
# Set to true ONLY when a load balancer or ingress you control overwrites
# X-Forwarded-For. While it is false the header is ignored, because otherwise any
# client can rotate it to get a fresh rate-limit bucket per request.
TRUST_PROXY=false

# ── Devices ───────────────────────────────────────────────────────────────────
# Concurrent Redroid containers. Each one is roughly 2 GB of RAM.
MAX_CONTAINERS=5

# Needed for native builds and the dev client. Usually already set by the SDK
# install; listed here so a container image can be checked against it.
# ANDROID_HOME=/opt/android-sdk
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# ── Optional ──────────────────────────────────────────────────────────────────
# Raises the GitHub API rate limit for the agent's research tool.
GITHUB_TOKEN=

# ── Harness flags ─────────────────────────────────────────────────────────────
# Most ship dark (unset = off); set to 1/true/on/v1 to enable. Two flipped
# default-ON at W8.1 (TALONSTUDIO_PIPELINE, TALONSTUDIO_PATCH_BUFFER) — there
# unset = on and 0/false/off is the rollback.
# Shadow-based retention (W1.1): TrimConversation writes a shadow marker into
# the session log so old turns drop out of what the model sees instead of
# being deleted from storage — the destructive delete is gone either way.
# Unset = trim is a no-op and the full transcript stays visible to the model.
TALONSTUDIO_TRIM_SHADOW=

# Tool dispatch (H3): the bounded harness pipeline drives batch dispatch by
# default since W8.1 — read-only calls overlap in a bounded pool, exclusive
# calls drain it first; transcripts are byte-identical either way
# (orchestrator/TestPipelineTranscriptParity). 0/false/off = legacy
# sequential dispatch (rollback).
TALONSTUDIO_PIPELINE=

# Bound on that pipeline's rolling pool, clamped to [1, 32] — a bound below
# 1 or a non-number falls back to the default (pipeline/poolFromEnv). This
# is a resilience knob (one stuck call cannot starve the rest), not a
# throughput dial.
TALONSTUDIO_TOOL_POOL=

# try_edit patch buffer (G6): interception on by default since W8.1 — a
# type-breaking edit auto-reverts to its pre-image with the reason on the
# tool_result. 0/false/off = legacy benign fallback (rollback;
# orchestrator/TestPatchBufferDefaultOn).
TALONSTUDIO_PATCH_BUFFER=

# Turn state card: the auto-generated situation report appended to every
# model request inside a turn (goal, round, reads/writes, check verdicts,
# last error, next action). Derived from the transcript each round, never
# stored — it rides the wire copy only, and lands in the trailing user
# message where the prompt-cache breakpoint never reaches. Default on;
# 0/false/off sends the plain transcript (orchestrator/TestAppendTurnState*).
TALONSTUDIO_TURN_STATE=

# Standing grants (W9): truthy (1/true/on/v1) records an approved tier-2
# shell escalation into the workspace's .talon/approvals.json — exact
# scope+action, sha256-pinned like plugins — so the next identical ask
# replays without prompting (approval/TestStandingGrantLifecycle).
# Unset/off: every sensitive act asks, exactly as before. The file is
# user-editable and diffable; the hard-deny class (secrets, egress exfil,
# path escapes) can never be waived by an entry in it.
# Permission MODES are config, not env: .talon/config.json
# "permission_mode" (read-only | ask | accept-edits | auto, default ask)
# sets the project posture; the prompt request's permission_mode field
# overrides it per session.
TALONSTUDIO_STANDING_GRANTS=

# W10 hooks (deterministic extensibility): truthy (1/true/on/v1) loads
# .talon/config.json's "hooks" object — lifecycle callbacks with the
# decision contract {allow|deny|ask, reason?, additionalContext?}.
# PreToolUse gates dispatch (deny's reason feeds the model like a
# guardrail; ask falls to the approval seam, fail-closed without one);
# TurnStart can close a turn before round one; UserPromptSubmit can refuse
# a prompt before it is stored; ApprovalRequest can allow/deny a seam ask
# (never below policy-never or read-only). Handlers: shell commands (stdin
# JSON payload, stdout JSON decision; exit 0 = proceed, exit 2 = block
# with stderr as the reason) and built-ins — block-env-edits (sync gate),
# run-tests-after-write (async, "command" = your test command), and
# slack-on-turn-fail (async, "webhook" URL). Entries may set "name",
# "async", "timeout_ms", "tools" (tool-name allowlist). Every execution
# audits (session log hook/exec + server log); a sync hook failure closes
# the turn — extension failure never corrupts the loop. Unset/off or no
# "hooks" key: no config read, byte-identical behavior
# (hooks/ + evals/TestPhaseW10HookDeny).
TALONSTUDIO_HOOKS=

# MCP (W11): .talon/config.json "mcp.servers" declares servers — stdio
# ("command" argv + optional "env") or http ("url" + optional "headers",
# ${ENV} expanded so tokens stay in the environment). Per-server policy:
# "allow"/"deny" = exact tool names (deny wins; a refused tool STAYS
# advertised and refuses at call time — H3's catalog-stability law), and
# "mutate" = the explicit escape from the read-only default, which then
# also needs a write-capable posture (permission_mode read-only or
# TALONSTUDIO_SANDBOX=read-only both refuse mutation at the executor).
# Tools join the one registry as mcp__<server>__<tool> and ride the shared
# pipeline (validateargs, guardrails, hooks, sandbox); a server that will
# not dial skips with a log line + its stderr tail — never the session.
# Pinned plugins may also declare tools (plugin__<name>__<tool>, always
# read-only, hash-verified cache). Unset/off: no config read,
# byte-identical (internal/mcp/ + evals/TestPhaseW11MCPThroughPipeline).
TALONSTUDIO_MCP=

# Delegation (H9/W1.5): registers delegate, delegate_fork, list_children —
# scoped child loops on the same model (a fork child starts from this
# conversation's history and forks its session log). One opt-in gates all of
# them. Unset = no delegation tools at all.
TALONSTUDIO_SUBAGENTS=

# W12 fan-out caps + child isolation (they take effect only once
# TALONSTUDIO_SUBAGENTS opts delegation in):
# TALONSTUDIO_CHILD_ISOLATION=worktree gives every mutating child (one whose
# delegate call sets mutating:true) a private detached git worktree of the
# workspace, merging the diff back on dispose (diff → apply → verify →
# cleanup; conflicts surface as structured CHILD_WORKTREE errors; non-git
# workspaces refuse). Unset/readonly = today's shared read-only children —
# byte-identical, and a mutating spawn is refused (DELEGATION_ISOLATION)
# rather than silently sharing writers.
# TALONSTUDIO_CHILD_SPEND_CAP bounds one turn's fan-out spend in USD
# (default 2, 0 = unlimited; invalid falls back to the default; per-child
# prices come from ROUTING_PRICING_JSON). TALONSTUDIO_CHILD_WALL_SECS bounds
# each child's runtime (default 600, 0 = unlimited). Both answer with
# structured DELEGATION_SPEND / DELEGATION_WALL refusals, keeping the
# partial fan-out durable (subagent/, evals/TestPhaseW12SpendCap*).
TALONSTUDIO_CHILD_ISOLATION=
TALONSTUDIO_CHILD_SPEND_CAP=
TALONSTUDIO_CHILD_WALL_SECS=

# Session-log read path (H1/W2): dual-write is always on; TALONSTUDIO_SESSIONLOG=derive
# reads the model's history from the append-only session log's projection instead of
# conversation_messages — proven message-for-message equivalent by the parity harness
# (api/TestPhaseW2ReadParity). Unset/legacy = today's table reads; the default flips
# only after two green CI weeks (PLAN_WORLDCLASS W2.2), with this value as rollback.
TALONSTUDIO_SESSIONLOG=

# Session write posture: TALONSTUDIO_SANDBOX=read-only makes every server
# session read-only fleet-wide (writes refused at the session layer —
# plan/audit style work) — useful for demo or incident modes. Unset or any
# other value = normal read-write sessions (api/sandboxModeFromEnv).
TALONSTUDIO_SANDBOX=

# Plan with eyes (W3.1/W3.3): plan turns get the read-only tool subset (list_files,
# read_file, grep_codebase, find_files, project_map, explore) in a bounded loop
# (maxPlanRounds=8) so the planner surveys the real workspace before drafting.
# Mutation stays impossible by tool absence; any failure falls back to today's
# tool-less single-shot plan call. Unset = today's tool-less plan path, byte for byte.
TALONSTUDIO_PLAN_TOOLS=

# Codebase index (W4): internal/index — per-file content hashes, syntactic
# chunks, symbols and import/call edges behind FTS5/bm25 retrieval, kept fresh
# by reconcile-on-touch (no filesystem watcher). Unset = no index is ever built
# and the codebase_search/codebase_graph tools never register — grep-only, no
# hard dependency (the plan's risk-mitigation contract). Rollback: clear it.
TALONSTUDIO_INDEX=

# Embedding provider (W4.3): any OpenAI-compatible /v1/embeddings endpoint
# (OpenAI and friends; local servers like Ollama/llama-server expose the same
# shape). URL alone enables it — keyless local endpoints work; the model
# defaults to text-embedding-3-small. Unset = the vector layer does not exist
# at all: no sweeps, no outbound calls, retrieval stays FTS + graph + grep (no
# hard dependency, per the plan's contract). Vectors fill in the background at
# session build and are cached by content hash — an unchanged chunk is never
# re-embedded. Rollback: clear the URL.
TALONSTUDIO_EMBED_URL=
TALONSTUDIO_EMBED_KEY=
TALONSTUDIO_EMBED_MODEL=text-embedding-3-small

# Language server (W5): typescript-language-server (template projects) and
# gopls (backend) as gate-zero senses — lsp_diagnostics/lsp_references/
# lsp_definition/lsp_symbol (+ lsp_organize_imports) register, the verify
# ladder gains its lsp rung ahead of tsc, and run_prettier honors
# .talon/config.json's "formatter" key. Missing server = structured
# LSP_UNAVAILABLE: the gate skips into SkippedGates and the ladder continues
# — never a blocked build. Unset = no lsp tools, no rung, byte-identical to
# shipped. Rollback: clear it.
TALONSTUDIO_LSP=

# Verification policy (W6): how a finished verify sweep classifies when a
# gate never ran. strict (default) = a skipped REQUIRED gate voids the
# claim — the turn reports verified:false and export/release/build_apk
# refuse until a clean sweep or an explicit override:true (audited as
# verify_override in audit_log). besteffort downgrades required-gate skips
# to a best-effort claim instead of refusing (verified stays true, marked
# verified_best_effort). Per-project override: .talon/config.json
# "verify_policy"; per-stage classes: "verify_gates"
# (e.g. {"vision":"off"} or {"lsp":"required"}). Unset/invalid = strict.
TALONSTUDIO_VERIFY_POLICY=

# Provider router (W7): multi-provider failover, vision model, and turn
# spend cap — every part ships dark behind this one flag. The settings
# document (attached via ai.AttachSettingsFile) becomes the one watched
# file with four sections: {"routing": {…}, "pricing": {"model":
# [in,out,cached]}, "providers": [{"name","protocol","base_url",
# "api_key","model"}], "model_tier": "strong|medium|weak"}. With the flag
# on: routing.fallback_provider names a providers-block entry to fail over
# to when the current provider errors (a circuit breaker with half-open
# probes pins usage/record and llm/retry to the endpoint that answered);
# routing.vision_model serves capture_screenshot/run_vision/run_interact
# on its own model; routing.max_turn_cost_usd caps one turn's spend and
# stops it honestly naming the spend (cost_usd/routed_provider/budget_stop
# appear in responses only when routed). Unset = single provider, vision
# rides the chat model, no spend cap — byte-identical to shipped.
# Rollback: clear it.
TALONSTUDIO_ROUTER=

# Routing policy seed (read even without TALONSTUDIO_ROUTER): JSON in the
# Policy shape — {"models": {"weak","medium","strong"}, "fallback_model",
# "small_edit_tier", "vision_model", "fallback_provider",
# "max_turn_cost_usd", …}. Compiled defaults + AI_MODEL/AI_MODEL_CHEAP sit
# underneath; invalid JSON is ignored with a log. With the router flag on,
# the settings document's "routing" section overlays this (doc wins —
# one watched file beats a restart).
ROUTING_POLICY_JSON=
# Token pricing seed for turn-cost accounting: {"model": [input, output,
# cached]} in USD per million tokens, merged over the compiled table.
# Settings-document "pricing" overlays it when the router is on; an
# unpriced model records 0 cost with a log naming this variable.
ROUTING_PRICING_JSON=

# Default prompt for cmd/talon-headless when no prompt argument is passed —
# the same text a CLI user would type, set once for a daemon/CI wrapper.
TALONSTUDIO_HEADLESS_PROMPT=

# cmd/talon-headless boot: DB path (default a fresh temp file) and the
# workspaces ROOT — each project id gets its child, like WORKSPACE_DIR
# (default a temp root). TALONSTUDIO_HEADLESS_PROVIDER, when set, points the
# headless boot at a REAL provider (AI_PROTOCOL / AI_API_KEY / AI_MODEL
# alongside it) instead of the built-in script; CI never sets it, so CI
# stays secret-free.
TALON_HEADLESS_DB=
TALON_HEADLESS_WORKSPACE=
TALONSTUDIO_HEADLESS_PROVIDER=

# Loop driver migration (H2/W14.1): "driver" arms the §2.4 listener bus —
# ToolPolicy/ToolDispatch/ToolResult/FSWrite events publish to composition
# subscribers (policy listeners may veto AFTER the built-in guardrails allow;
# observers never decide). Anything else — legacy, off, a typo — is today's
# path byte-for-byte: the flag fails CLOSED to legacy. Composition policy
# rows only take effect with this on.
TALONSTUDIO_LOOP=

# Composition (H12/W14.2): talon.composition.yaml is the wiring source —
# a row overrides the env seed it names (a harness/loop row beats
# AI_MAX_ROUNDS). TALONSTUDIO_COMPOSITION names an explicit file (fails
# loud when it is missing); otherwise the boot walks up from the working
# directory to the tree's talon.composition.yaml. TALONSTUDIO_PROFILE
# selects the overlay profile (default: the binary's own name — server,
# headless); TALONSTUDIO_PRESET selects the preset layer. `--dump-config`
# prints what a boot would apply.
TALONSTUDIO_COMPOSITION=
TALONSTUDIO_PROFILE=
TALONSTUDIO_PRESET=

# Golden transcript re-record (dev only): truthy (1|true|on|v1) lets
# `go test ./internal/evals/golden/ -run TestGoldenSuite` REWRITE the committed
# *.golden.json files from current behavior. NEVER set in CI — the suite's tree
# guard fails if the run would dirty the working tree, so a prompt/tool/
# guardrail behavior change can only land as a reviewed golden diff.
TALONSTUDIO_UPDATE_GOLDEN=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
